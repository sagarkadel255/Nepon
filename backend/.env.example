NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nepon
REDIS_URL=redis://localhost:6379

# ── JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')" ──
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Field encryption (TOTP secrets, shipping PII) ──────────
# Separate from the JWT secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── Email (Ethereal for dev: https://ethereal.email) ───────
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@nepon.com

# ── Cloudinary (image uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Service URLs ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
AI_ENGINE_URL=http://localhost:8000

# ── MFA ────────────────────────────────────────────────────
TOTP_ISSUER=NEPON
